# Bloomberg Hub — copy to .env and fill in what you need.
# Nothing here is required to run the dashboard: every source degrades to a
# specific, actionable error rather than a crash. Check /sources to see which
# keys unlock what.

# ─── The money gate ────────────────────────────────────────────────────────
# Leave at 0. Setting it to 1 arms the ONE package that can hold keys and place
# orders (src/polymarket/client.py). Use a separate wallet with a small balance.
# Note: Polymarket's own hosts are blocked from this ISP, so even with the gate
# open, orders will not reach them from this machine.
BH_ENABLE_TRADING=0

# ─── Polymarket (blocked here — needs a VPS/VPN) ───────────────────────────
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=
POLY_WALLET_ADDRESS=
POLY_PRIVATE_KEY=
POLY_HOST=https://clob.polymarket.com

# ─── Polygon RPC (works from here — the on-chain path) ─────────────────────
# Fallbacks are built in: publicnode, drpc, 1rpc.
POLYGON_RPC=https://polygon.publicnode.com

# ─── Culture ───────────────────────────────────────────────────────────────
# Music (Deezer) and TV (TVmaze) need no key at all — nothing to fill in here.
# Films use OMDb. The key is free: omdbapi.com/apikey.aspx, 1,000 requests/day.
OMDB_API_KEY=

# Spotify and TMDb are no longer used by any page. Both went paid in 2026 —
# Spotify wants a Premium subscription, TMDb USD 149/month. The classes are
# still in src/culture/__init__.py and work if you do subscribe. Leave blank.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
TMDB_API_KEY=

# ─── Tech ──────────────────────────────────────────────────────────────────
# Optional. Raises the HuggingFace rate limit; public reads work without it.
HF_TOKEN=

# ─── Esports ───────────────────────────────────────────────────────────────
# Only needed for League of Legends. Dota 2 (OpenDota) needs nothing.
RIOT_API_KEY=

# ─── StatsBomb ─────────────────────────────────────────────────────────────
# Only for paid competitions. Open data needs nothing.
SB_USERNAME=
SB_PASSWORD=

# ─── Machine learning & paper test ─────────────────────────────────────────
# Virtual money only — nothing here can place a real order.
# Flat stake per paper position, in dollars.
BH_PAPER_STAKE=10
# Minimum model EV (fraction of stake) before a paper position opens. 0.05 = 5%.
BH_PAPER_MIN_EV=0.05
# Only markets whose deadline is within this many days are scanned.
BH_PAPER_MAX_DAYS=14
# Settle + scan every N minutes while the web app runs (virtual money). 0 = off.
# Without the web app: schedule "python run.py paper --scan" in Task Scheduler.
BH_PAPER_AUTOSCAN_MIN=60

# ─── LLM (optional, paid per use) ──────────────────────────────────────────
# Claude reads the headlines for one market when you press the button.
# Key: Claude Console, https://platform.claude.com → API keys. Claude Opus 5 costs $5 / $25 per
# million input / output tokens; one market reading is usually a few cents.
ANTHROPIC_API_KEY=
# Default is the newest Opus. Other valid IDs: claude-fable-5-1, claude-sonnet-5, claude-haiku-4-5
BH_LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max — empty = API default (high). Lower is cheaper.
BH_LLM_EFFORT=

# ─── Web app ───────────────────────────────────────────────────────────────
BH_HOST=127.0.0.1
BH_PORT=5000
BH_DEBUG=0
BH_CACHE_TTL=900
BH_SECRET_KEY=bloomberg-hub-local
